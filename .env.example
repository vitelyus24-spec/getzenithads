# Default: authentication disabled until Firebase is configured. Never paste secrets in VITE_*.
APP_MODE=local
STORE=file
PORT=5173
APP_ORIGIN=http://localhost:5173
# Explicit local-only fixtures; production/VERCEL rejects DEMO_AUTH=true.
DEMO_AUTH=false
ALLOW_PAID_AI=false
AI_PROVIDER=disabled
# mock is allowed only with APP_MODE=local, never in hosted production.
FIREBASE_PROJECT_ID=zenithads-core
# Server credential JSON: use secret manager, not Git. Prefer workload identity/ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=zenithads-core.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zenithads-core
VITE_EMAIL_AUTH_ENABLED=false
# Explicit pilot allowlist; empty refuses onboarding. No unsolicited production users.
PILOT_UIDS=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
# Pricing must be configured to reserve an upper bound BEFORE enabling paid calls.
TEXT_INPUT_USD_PER_MILLION=
TEXT_OUTPUT_USD_PER_MILLION=
IMAGE_MAX_COST_USD=
ORG_DAILY_MAX_USD=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MAP_JSON={}
# Worker service authentication, >=32 random characters; never browser-exposed.
WORKER_SECRET=
