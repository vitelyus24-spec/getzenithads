{
  "name": "zenithads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/check.js",
    "check": "npm run lint && npm test && npm run build",
    "worker": "node --env-file-if-exists=.env scripts/worker.js",
    "stripe:catalog": "node --env-file-if-exists=.env scripts/stripe-catalog.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src server api config tests scripts *.js *.json *.html docs/*.md README.md",
    "test:dom": "npm run build && node --experimental-vm-modules --test tests/dom/*.test.js"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
